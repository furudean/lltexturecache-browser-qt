#!/usr/bin/env python3

import subprocess
import tomllib
from pathlib import Path


def is_dirty(root: Path) -> bool:
    try:
        status = subprocess.run(
            ["git", "status", "--porcelain"],
            cwd=root,
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError:
        return False

    if status.returncode != 0:
        return False

    return bool(status.stdout.strip())


def main() -> None:
    root = Path(__file__).parent.parent
    with open(root / "pyproject.toml", "rb") as f:
        config = tomllib.load(f)

    name = config["project"]["name"]
    version = config["project"]["version"]
    display_name = config["tool"].get("app", {}).get("display-name", name)

    if is_dirty(root):
        version += "-dirty"

    out = root / name.replace("-", "_") / "_meta.py"
    out.write_text(
        f'APP_NAME = "{name}"\nAPP_DISPLAY_NAME = "{display_name}"\n__version__ = "{version}"\n'
    )
    print(f"wrote {display_name} {version} to {out}")

if __name__ == "__main__":
    main()
