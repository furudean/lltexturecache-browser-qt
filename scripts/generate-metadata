#!/usr/bin/env python3

import runpy
import subprocess
from pathlib import Path

app_info = runpy.run_path(str(Path(__file__).parent / "app-info"))

ROOT: Path = app_info["ROOT"]
read = app_info["read"]


def is_dirty(root: Path) -> bool:
    try:
        status = subprocess.run(
            ["git", "status", "--porcelain"],
            cwd=root,
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError:
        return False

    if status.returncode != 0:
        return False

    return bool(status.stdout.strip())


def main() -> None:
    info = read()
    version = info.version

    if is_dirty(ROOT):
        version += "-dirty"

    out = ROOT / info.package / "_meta.py"
    out.write_text(f'APP_NAME = "{info.name}"\nAPP_DISPLAY_NAME = "{info.display_name}"\n__version__ = "{version}"\n')
    print(f"wrote {info.display_name} {version} to {out}")


if __name__ == "__main__":
    main()
