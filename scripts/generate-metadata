#!/usr/bin/env python3

import runpy
import subprocess
from pathlib import Path

app_info = runpy.run_path(str(Path(__file__).parent / "app-info"))

ROOT: Path = app_info["ROOT"]
read = app_info["read"]


def git(root: Path, *args: str) -> str | None:
    try:
        result = subprocess.run(["git", *args], cwd=root, capture_output=True, text=True, check=False)
    except OSError:
        return None

    if result.returncode != 0:
        return None

    return result.stdout.strip()


def is_dirty(root: Path) -> bool:
    return bool(git(root, "status", "--porcelain"))


def is_release_commit(root: Path, version: str) -> bool:
    head = git(root, "rev-parse", "--verify", "HEAD")
    tagged = git(root, "rev-parse", "--verify", "--quiet", f"refs/tags/v{version}^{{commit}}")

    return head is not None and head == tagged


def main() -> None:
    info = read()
    version = info.version
    dirty = is_dirty(ROOT)

    # a build off the release commit carries the version, anything else carries the hash it came from
    if dirty or not is_release_commit(ROOT, version):
        head = git(ROOT, "rev-parse", "--short", "HEAD")
        if head:
            version = head

    if dirty:
        version += "-dirty"

    out = ROOT / info.package / "_meta.py"
    out.write_text(f'APP_NAME = "{info.name}"\nAPP_DISPLAY_NAME = "{info.display_name}"\n__version__ = "{version}"\n')
    print(f"wrote {info.display_name} {version} to {out}")


if __name__ == "__main__":
    main()
